# Copy to .env. Defaults run locally without credentials or outbound calls.
LLM_PROVIDER=offline
# For Gemini: set LLM_PROVIDER=gemini and use a project WITHOUT Cloud Billing.
# Gemini mode pins its endpoint/model and ignores LLM_API_KEY/BASE_URL/MODEL.
# For clarity when selecting Gemini, set LLM_BASE_URL to Google and LLM_MODEL to gemini-3.8-flash.
GEMINI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=8
OCR_PROVIDER=tesseract
OCR_LANGUAGES=kan+eng
# Install Tesseract and Kannada/English traineddata separately for image OCR.
TTS_PROVIDER=offline
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
TTS_VOICE=kn-IN-SapnaNeural
# Mandatory gate: false is rejected at startup, never a privacy bypass.
PII_REDACTION_ENABLED=true
MAX_UPLOAD_BYTES=5000000
PIPELINE_TIMEOUT_SECONDS=28
HIGH_RATE_THRESHOLD=36
